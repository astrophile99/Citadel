# Normalise line endings in the repository, whatever machine checks it out.
* text=auto

# Shell scripts must keep Unix endings or they fail on Linux and macOS (and in CI).
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts keep Windows endings.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.jks binary
*.keystore binary
