<?xml version="1.0" encoding="utf-8"?>
<!--
  A small window into the Citadel. The scene is a bitmap rendered by the app's own
  painters; the text sits in the veiled lower ground exactly as it does on the Hearth.
  Each row's mark is its own ImageView rather than a compound drawable, so the ring keeps
  a constant size when the system font is enlarged.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true"
    tools:targetApi="s">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_scene_description" />

    <TextView
        android:id="@+id/widget_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="13dp"
        android:fontFamily="sans-serif-medium"
        android:importantForAccessibility="no"
        android:letterSpacing="0.24"
        android:text="@string/widget_wordmark"
        android:textColor="#D4A84F"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/widget_greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="1"
            android:textColor="#F4F1EA"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/widget_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_mark_1"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ring" />

            <TextView
                android:id="@+id/widget_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F1EA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_mark_2"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ring" />

            <TextView
                android:id="@+id/widget_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F1EA"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:id="@+id/widget_mark_3"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ring" />

            <TextView
                android:id="@+id/widget_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F4F1EA"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:ellipsize="end"
            android:letterSpacing="0.03"
            android:maxLines="1"
            android:textColor="#B7BDC8"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
